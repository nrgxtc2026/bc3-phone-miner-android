<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/miningRoot"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F7931A">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="18dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
            <ImageView android:layout_width="38dp" android:layout_height="38dp" android:src="@drawable/logo" android:contentDescription="BC3" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="10dp" android:text="BC3 MINER" android:textColor="#17202A" android:textSize="18sp" android:textStyle="bold" />
            <ImageButton android:id="@+id/logButton" android:layout_width="46dp" android:layout_height="46dp"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Open mining log"
                android:src="@drawable/ic_pickaxe" android:tint="#C0C0C0" />
        </LinearLayout>

        <TextView android:id="@+id/hashRate" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:gravity="center" android:text="-- kH/s" android:textColor="#17202A"
            android:textSize="48sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
            android:text="LIVE HASHRATE" android:textColor="#5A3515" android:textSize="12sp" />
        <TextView android:id="@+id/workerName" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:gravity="center" android:text="WORKER"
            android:textColor="#4A2600" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/miningStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:gravity="center" android:text="STARTING MINER"
            android:textColor="#4A2600" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/cpuValue" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:gravity="center" android:text="CPU • DETECTING HARDWARE"
            android:textColor="#342414" android:textSize="13sp" android:textStyle="bold" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp"
            android:background="@drawable/mining_stats_card" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/acceptedCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#74E39A" android:textSize="25sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ACCEPTED" android:textColor="#000000" android:textSize="11sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/rejectedCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FF6B6B" android:textSize="25sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="REJECTED" android:textColor="#000000" android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/acceptedRate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0 /hr" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ACCEPTED / HOUR" android:textColor="#000000" android:textSize="10sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/maxHashRate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- MH/s" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MAX HASHRATE" android:textColor="#000000" android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/uptimeValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00:00:00" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="UPTIME" android:textColor="#000000" android:textSize="10sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/temperatureValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- °C" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TEMPERATURE" android:textColor="#000000" android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/batteryValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--%" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BATTERY" android:textColor="#000000" android:textSize="10sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/chargeStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="UNKNOWN" android:textColor="#74E39A" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CHARGE STATUS" android:textColor="#000000" android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

        <FrameLayout android:layout_width="match_parent" android:layout_height="68dp">
            <TextView android:id="@+id/slideLabel" android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="@drawable/slider_track" android:gravity="center"
                android:paddingStart="58dp" android:paddingEnd="12dp"
                android:text="›››  SLIDE TO STOP" android:textColor="#EAF3F7"
                android:textSize="14sp" android:textStyle="bold" />
            <SeekBar android:id="@+id/stopSlider" android:layout_width="match_parent" android:layout_height="match_parent"
                android:max="100" android:progress="0" android:background="@android:color/transparent"
                android:progressTint="#00000000" android:progressBackgroundTint="#00000000"
                android:splitTrack="false" android:thumb="@drawable/slider_thumb" android:thumbOffset="0dp" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/logPanel" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#F2070B10" android:orientation="vertical" android:padding="16dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="⛏  MINING LOG" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:id="@+id/closeLog" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center"
                android:text="✕" android:textColor="#FFFFFF" android:textSize="24sp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Newest output appears at the bottom" android:textColor="#8093A8" android:textSize="12sp" />
        <ScrollView android:id="@+id/logScroll" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:layout_marginTop="10dp" android:background="@drawable/mining_card" android:fillViewport="true">
            <TextView android:id="@+id/logText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="monospace" android:padding="10dp" android:text="Waiting for miner output…"
                android:textColor="#A8F0C3" android:textIsSelectable="true" android:textSize="11sp" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout android:id="@+id/safetyPanel" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#F5070B10" android:gravity="center" android:orientation="vertical"
        android:padding="28dp" android:visibility="gone">
        <ImageView android:layout_width="74dp" android:layout_height="74dp" android:src="@drawable/logo" android:contentDescription="BC3" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:gravity="center" android:text="MINING PAUSED FOR SAFETY" android:textColor="#FF6B6B"
            android:textSize="22sp" android:textStyle="bold" />
        <TextView android:id="@+id/safetyReason" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:gravity="center" android:textColor="#FFFFFF" android:textSize="16sp" />
        <TextView android:id="@+id/safetyCountdown" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:gravity="center" android:text="10:00" android:textColor="#FF9D19"
            android:textSize="48sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
            android:text="Mining resumes automatically after the cooldown."
            android:textColor="#B7C6D8" android:textSize="14sp" />
        <Button android:id="@+id/safetyStopButton" android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="28dp" android:backgroundTint="#D93646" android:text="STOP MINING"
            android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
